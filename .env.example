# Claude Proxy Configuration
HOST_PORT=8181
BACKEND_URL=https://llm.chutes.ai/v1/chat/completions
# Optional: override the Host header sent to the backend (useful for internal k8s routing)
# BACKEND_HOST_HEADER=llm.chutes.ai
RUST_LOG=info

# Caddy Configuration
CADDY_PORT=443
CADDY_TLS=true

# Caddy Domain (optional - if set, enables automatic HTTPS)
CADDY_DOMAIN=claude.chutes.ai
BACKEND_TIMEOUT_SECS=300
ENABLE_CIRCUIT_BREAKER=false

# End-to-end encryption (E2E) for TEE models.
# When true, POST /v1/messages for a model whose ID contains "-TEE" is routed
# through the Chutes E2E channel (instance discovery + TDX attestation +
# ML-KEM-768 request encryption); non-TEE models and unrecoverable E2E
# failures fall back to plain HTTP passthrough.
E2E_ENABLED=false
# E2E control-plane base URL (discovery + invoke). Defaults to https://api.chutes.ai
# E2E_API_BASE=https://api.chutes.ai

# Optional: public IP of a miner's TEE worker node, supplied out-of-band by the
# operator. When set, the E2E path fetches a live TDX quote from the miner's
# attestation service at https://<CHUTES_MINER_IP>:30443/server/attest and
# verifies it first. When unset, attestation falls back to the user-reachable
# evidence endpoint (use_evidence). The raw :30443/server/attest hop is
# validator-gated in production, so this is for operators with valid credentials.
# CHUTES_MINER_IP=1.2.3.4
